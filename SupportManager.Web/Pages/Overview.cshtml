@page
@model SupportManager.Web.Pages.OverviewModel
@{
    ViewBag.Title = "Support overview";
}

<h2>Support overview</h2>

@if (Model.Data.Teams.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Team</th>
                <th>Current support</th>
                <th>Phonenumber</th>
                <th>Since</th>
                <th>Next up</th>
                <th>From</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Data.Teams.Count; i++)
            {
                var team = Model.Data.Teams[i];
                <tr>
                    <td>
                        <a asp-area="Teams" asp-page="/Index" asp-route-TeamId="@team.Id">@Html.Display(m => m.Data.Teams[i].Name)</a>
                    </td>
                    @if (team.CurrentSince != null)
                    {
                        <td>
                            @if (team.CurrentUser != null)
                            {
                                @Html.Display(m => m.Data.Teams[i].CurrentUser)
                            }
                            else
                            {
                                <span class="text-muted">Unknown</span>
                            }
                        </td>
                        <td>@Html.Display(m => m.Data.Teams[i].CurrentPhoneNumber)</td>
                        <td>@Html.Display(m => m.Data.Teams[i].CurrentSince)</td>
                    }
                    else
                    {
                        <td colspan="3" class="text-muted">No current forwarding state</td>
                    }
                    @if (team.NextWhen != null)
                    {
                        <td>@Html.Display(m => m.Data.Teams[i].NextUser)</td>
                        <td>@Html.Display(m => m.Data.Teams[i].NextWhen)</td>
                    }
                    else
                    {
                        <td colspan="2" class="text-muted">Nothing scheduled</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="jumbotron">No teams exist yet.</div>
}

<a class="btn btn-secondary" asp-page="User/Index">User details</a>
