@page
@model SupportManager.Web.Pages.OverviewModel
@{
    ViewBag.Title = "Support overview";
}

<h2>Support overview</h2>

@if (Model.Data.Teams.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>Team</th>
                <th>Current support</th>
                <th>Phonenumber</th>
                <th>Since</th>
                <th>Next up</th>
                <th>From</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var team in Model.Data.Teams)
            {
                <tr>
                    <td>
                        <a asp-area="Teams" asp-page="/Index" asp-route-TeamId="@team.Id">@team.Name</a>
                    </td>
                    @if (team.CurrentSince != null)
                    {
                        <td>@(team.CurrentUser ?? "Unknown")</td>
                        <td>@team.CurrentPhoneNumber</td>
                        <td>@team.CurrentSince</td>
                    }
                    else
                    {
                        <td colspan="3" class="text-muted">No current forwarding state</td>
                    }
                    @if (team.NextWhen != null)
                    {
                        <td>@team.NextUser</td>
                        <td>@team.NextWhen</td>
                    }
                    else
                    {
                        <td colspan="2" class="text-muted">Nothing scheduled</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="jumbotron">No teams exist yet.</div>
}

<a class="btn btn-secondary" asp-page="User/Index">User details</a>
